# Server Configuration
PORT=4000
NODE_ENV=development

# Database Settings
DB_PATH=./forex_bot.db

# Twelve Data API Credentials (signup at twelvedata.com for free API key)
TWELVE_DATA_API_KEY=your_twelvedata_api_key_here

# Simulation Mode (true/false)
USE_SIMULATOR=true

# Trading Settings
CURRENCY_PAIRS=EUR/USD,GBP/USD,USD/JPY
CANDLE_GRANULARITY=1h
POLL_INTERVAL_SECONDS=60

# Portfolio & Order Simulation Settings
STARTING_BALANCE=5000
SPREAD_PIPS=1.5
SLIPPAGE_PIPS=0.5

# Risk Management Settings
RISK_MAX_POSITION_SIZE_PCT=2
RISK_MAX_CONCURRENT_POSITIONS=5
RISK_DAILY_LOSS_LIMIT_PCT=5

# ML Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8000

# Enabled Strategies
ENABLED_STRATEGIES=ma_crossover,rsi_reversion,bollinger_bands,ml_signal

# MT5 Live Account Credentials
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=

# Telegram Notifier Credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Authentication & Security (API_SECRET_KEY must be at least 16 characters)
API_SECRET_KEY=your_secure_random_string_here_min_16_chars
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Phase 2: Trade Gating Controls
# TRADING_SESSIONS=LONDON,NY
# TRADING_DAYS=1,2,3,4,5
# NEWS_BLACKOUT_MINUTES_BEFORE=30
# NEWS_BLACKOUT_MINUTES_AFTER=30
# NEWS_RESTRICT_IMPACT=HIGH
# RISK_DAILY_PROFIT_LOCK_PCT=3.0
# TRADE_DIRECTION=BOTH
# HOLIDAY_GUARD_ENABLED=true

# Phase 3: Execution Quality
# USE_ATR_SIZING=true
# ATR_SL_MULTIPLIER=1.5
# ATR_TP_MULTIPLIER=3.0
# ALERT_LATENCY_MS=500
# ALERT_SLIPPAGE_PIPS=2.0
