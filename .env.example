# =============================================================================
# Treadiiiio Forex Trading Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_PATH=./forex_bot.db

# ---------------------------------------------------------------------------
# Market Data (Twelve Data — signup at twelvedata.com for a free key)
# ---------------------------------------------------------------------------
TWELVE_DATA_API_KEY=your_twelvedata_api_key_here

# Use live Twelve Data prices (true) or the built-in tick simulator (false)
USE_SIMULATOR=true
USE_REAL_PRICES=false

# ---------------------------------------------------------------------------
# Trading Instruments & Timing
# ---------------------------------------------------------------------------
CURRENCY_PAIRS=EUR/USD,GBP/USD,USD/JPY
CANDLE_GRANULARITY=15m
POLL_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Account & Friction
# ---------------------------------------------------------------------------
# Starting balance in USD. Accounts < $200 are forced into conservative mode.
STARTING_BALANCE=5000
SPREAD_PIPS=1.5
SLIPPAGE_PIPS=0.5

# ---------------------------------------------------------------------------
# Core Risk Management
# ⚠  RISK_MAX_POSITION_SIZE_PCT is hard-capped at 2 — the API refuses values above 2.
# ---------------------------------------------------------------------------
RISK_MODE=conservative               # conservative | standard | aggressive
RISK_BASE_PCT_PER_TRADE=1.0          # Base risk % per trade (capped by RISK_MAX_POSITION_SIZE_PCT)
RISK_MAX_POSITION_SIZE_PCT=2         # Absolute per-trade risk ceiling (never raise above 2)
RISK_MAX_CONCURRENT_POSITIONS=5      # Max simultaneously open positions
RISK_MAX_TOTAL_OPEN_RISK_PCT=3.0     # Max aggregate open risk %
RISK_DAILY_LOSS_LIMIT_PCT=5          # Halt trading when today's loss exceeds this %
RISK_WEEKLY_LOSS_LIMIT_PCT=12.0      # Halt trading when 7-day loss exceeds this %
RISK_DAILY_PROFIT_LOCK_PCT=3.0       # Lock in profits and halt when daily gain hits this %
RISK_MAX_DRAWDOWN_PCT=30.0           # Peak-equity circuit breaker threshold (%)
RISK_MAX_RECOVERY_CUMULATIVE_PCT=4.0 # Max cumulative recovery-mode risk in 24 h

# ---------------------------------------------------------------------------
# Correlation Groups (pipe-separated groups, comma-separated pairs)
# ---------------------------------------------------------------------------
CORRELATION_GROUPS=USD:EUR/USD,GBP/USD,USD/JPY,AUD/USD,USD/CHF

# ---------------------------------------------------------------------------
# Strategies
# Available: ma_crossover, rsi_reversion, bollinger_bands, ml_signal, loss_recovery
# ---------------------------------------------------------------------------
ENABLED_STRATEGIES=ma_crossover,rsi_reversion,bollinger_bands,ml_signal

# ---------------------------------------------------------------------------
# ML Microservice
# ---------------------------------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8000
ML_MIN_CONFIDENCE=0.62               # Minimum confidence to accept a prediction

# ---------------------------------------------------------------------------
# Phase 4 — Realistic Edge Upgrade
# ---------------------------------------------------------------------------

# Area 1: Dynamic Position Sizing
ML_CONFIDENCE_FULL_SIZE=0.80         # Confidence at which the ML confidence scalar = 1.0
SIZING_VOL_TARGET_PERCENTILE=0.5     # ATR percentile treated as "normal" (50th = median)

# Area 2: ML Gate Hardening
ML_REQUIRE_RULE_CONFIRMATION=true    # Require ≥ ML_MIN_RULE_CONFIRMATIONS rule families to agree
ML_MIN_RULE_CONFIRMATIONS=1          # Min rule families (SMA/RSI/BB) that must agree with ML direction

# Area 3: Bounded Loss Recovery
RECOVERY_MAX_CONSECUTIVE_LOSSES=3    # Consecutive losing recovery trades before auto-disable
RECOVERY_COOLDOWN_HOURS=24           # Hours recovery mode stays disabled after auto-disable

# Area 4: Consecutive-Loss Cooldown
RISK_MAX_CONSECUTIVE_LOSSES=5        # Losses in a row that trigger an entry cooldown
RISK_CONSECUTIVE_LOSS_COOLDOWN_HOURS=4  # Length of the entry cooldown (hours)

# ---------------------------------------------------------------------------
# Phase 2: Trade Gating
# ---------------------------------------------------------------------------
TRADING_SESSIONS=LONDON,NY           # Allowed session windows
TRADING_DAYS=1,2,3,4,5               # 1=Mon … 5=Fri
NEWS_BLACKOUT_MINUTES_BEFORE=30
NEWS_BLACKOUT_MINUTES_AFTER=30
NEWS_RESTRICT_IMPACT=HIGH
TRADE_DIRECTION=BOTH                 # BUY_ONLY | SELL_ONLY | BOTH
HOLIDAY_GUARD_ENABLED=true

# ---------------------------------------------------------------------------
# Phase 3: Execution Quality
# ---------------------------------------------------------------------------
USE_ATR_SIZING=true
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0
ALERT_LATENCY_MS=500
ALERT_SLIPPAGE_PIPS=2.0

# ---------------------------------------------------------------------------
# MT5 Live Account (consumed by the Python bridge — NOT the Node schema)
# ---------------------------------------------------------------------------
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=

# ---------------------------------------------------------------------------
# Telegram Notifications
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# API_SECRET_KEY must be at least 16 characters (used to authenticate dashboard)
API_SECRET_KEY=your_secure_random_string_here_min_16_chars
CORS_ALLOWED_ORIGIN=http://localhost:3000
