SCALPER_MAX_SPREAD_RATIO=0.25
SCALPER_TP_PIPS=12.0
SCALPER_SL_PIPS=8.0
SCALPER_TIME_STOP_MINUTES=20
SCALPER_MAX_TRADES_PER_HOUR=2
SCALPER_DAILY_LOSS_LIMIT_USD=3.0

