# =============================================================================
# Treadiiiio Forex & Gold Bot — Production Deployment Environment Variables
# Copy and paste these into your Voroa service "Environment Variables" section.
# =============================================================================

# Server & Runtime
NODE_ENV=production
PORT=4000

# Database Storage
DB_PATH=./data/forex_bot.db

# Market Data Feed Keys
TWELVE_DATA_API_KEY=ec4b65f688f44afaa2dbcc5c40b9ee62
ALPHA_VANTAGE_API_KEY=K8UYJI3ODKVG0X05
MASSIVE_API_KEY=RPlbk0FN2femlRAfRNE_SafThj2x3TYj
GOLD_API_KEY=goldapi-2f4eaacb05107f8dfa70348fb883283a-io

# Trading & Price Simulation Mode
USE_SIMULATOR=false
USE_REAL_PRICES=true

# Trading Instruments & Frequency (XAU/USD Gold Focus)
CURRENCY_PAIRS=XAU/USD
CANDLE_GRANULARITY=1m
POLL_INTERVAL_SECONDS=5

# Portfolio & Account Settings ($100 Capital Protection Calibration)
STARTING_BALANCE=100.00
SPREAD_PIPS=2.2
SLIPPAGE_PIPS=0.5
ALERT_SLIPPAGE_PIPS=1.5

# Risk Management & Circuit Breakers (Survival Mode)
RISK_MODE=conservative
RISK_BASE_PCT_PER_TRADE=1.0
RISK_MAX_POSITION_SIZE_PCT=1.0
RISK_MAX_CONCURRENT_POSITIONS=1
RISK_DAILY_LOSS_LIMIT_PCT=4.0
RISK_WEEKLY_LOSS_LIMIT_PCT=8.0
RISK_MAX_DRAWDOWN_PCT=15.0
RISK_MAX_TOTAL_OPEN_RISK_PCT=3.0
RISK_MAX_RECOVERY_CUMULATIVE_PCT=2.0
RISK_DAILY_PROFIT_LOCK_PCT=10.0
RISK_DAILY_PROFIT_TARGET_USD=10.00
RISK_TRADE_TAKE_PROFIT_USD=0.00
RISK_MAX_DAILY_TRADES=4
MAX_PORTFOLIO_CORRELATION_SUM=1.5

# AI & Signal Confidence Gating
ML_CONFIDENCE_FULL_SIZE=0.75
SIZING_VOL_TARGET_PERCENTILE=0.5
ML_REQUIRE_RULE_CONFIRMATION=true
ML_MIN_RULE_CONFIRMATIONS=2
ML_MIN_CONFIDENCE=0.62
RISK_CONFIDENCE_MIN_THRESHOLD=0.60
PAIR_CONFIDENCE_THRESHOLDS=XAU/USD:0.60,EUR/USD:0.60,GBP/USD:0.60,USD/JPY:0.60
RECOVERY_MAX_CONSECUTIVE_LOSSES=2
RECOVERY_COOLDOWN_HOURS=4
RISK_MAX_CONSECUTIVE_LOSSES=2
RISK_CONSECUTIVE_LOSS_COOLDOWN_HOURS=4

# Trading Sessions & Safety Filters
TRADING_SESSIONS=LONDON,NY
TRADING_DAYS=1,2,3,4,5
NEWS_BLACKOUT_MINUTES_BEFORE=30
NEWS_BLACKOUT_MINUTES_AFTER=15
NEWS_RESTRICT_IMPACT=HIGH
USE_NEWS_SENTIMENT_GATE=true
TRADE_DIRECTION=BOTH
ENABLE_STRICT_MTF_GATE=true
HOLIDAY_GUARD_ENABLED=true

# Execution Quality (1:4 ATR Risk-to-Reward Ratio)
USE_ATR_SIZING=true
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=4.0
ALERT_LATENCY_MS=500

# Correlation Exposure Groups
CORRELATION_GROUPS=USD:EUR/USD,GBP/USD,USD/JPY,AUD/USD,USD/CHF|GOLD:XAU/USD

# Microservice URL (Internal / Onnx Fallback)
ML_SERVICE_URL=http://127.0.0.1:8000

# Active Strategies (Gold Alpha + 1m Scalper)
